{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "public/index.html"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.js" },
    { "src": "/uploads/(.*)", "dest": "api/index.js" },
    { "src": "/download/(.*)", "dest": "api/index.js" },
    { "src": "/view/(.*)", "dest": "api/index.js" },
    { "src": "/[^.]*", "dest": "api/index.js" }
  ]
}
